{
  "request": {
    "method": "POST",
    "urlPath": "/corveil/v2/credit-report"
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "fixedDelayMilliseconds": 180,
    "jsonBody": {
      "reportId": "corv-{{randomValue type='UUID'}}",
      "bureau": "CORVEIL",
      "score": 691,
      "scoreModel": "CV-SB-8",
      "tradelines": 11,
      "inquiries90d": 1,
      "delinquencies24m": 0,
      "reasonCodes": ["T01", "I15", "B22"]
    },
    "transformers": ["response-template"]
  },
  "priority": 10
}
