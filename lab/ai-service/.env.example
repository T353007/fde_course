# ai-service settings. Copy to .env and change what you need.
# Defaults run fully offline with the stub provider.

LLM_PROVIDER=stub
STUB_SCENARIO=default
# Tests set this to 0 so slow-p99 does not sleep for real.
STUB_SLOW_SCALE=1.0

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_ROUTER_MODEL=qwen3:1.7b
OLLAMA_COMPARE_MODEL=llama3.1:8b

# Hosted providers. Leave blank for the course path.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Retrieval. Do not change RETRIEVAL_TENANT_FILTER_MODE unless a mission says to.
RETRIEVAL_TOP_K=4
EMBEDDING_BACKEND=hash

# Retry. legacy is the Mission 32 behavior. typed is the fix.
RETRY_POLICY=legacy

# Memo context. full_corpus is expensive. retrieved is the later fix.
MEMO_POLICY_CONTEXT=full_corpus

# Tool authorization. false is the Mission 27 default.
ENFORCE_TOOL_AUTHORIZATION=false
